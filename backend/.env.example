# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/olympido_dev?schema=public"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-token-key-256-bit-string"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-256-bit-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/oauth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/oauth/github/callback"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="olympido-assets"
S3_REGION="us-east-1"

# Bcrypt
BCRYPT_ROUNDS=12

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"
