# ============================================================
# Olympido Backend - Production Environment Template
# ============================================================

# Application
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://olympido.com

# PostgreSQL Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL=postgresql://olympido_admin:change_me_to_strong_db_password@postgres:5432/olympido_prod?schema=public

# Redis Connection (Leaderboards & Rate Limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_to_strong_redis_password

# JWT Authentication (generate with `openssl rand -base64 64`)
JWT_ACCESS_SECRET=generate_strong_random_256_bit_secret_for_access_token
JWT_REFRESH_SECRET=generate_strong_random_256_bit_secret_for_refresh_token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Bcrypt Hash Rounds
BCRYPT_ROUNDS=12

# S3 / MinIO Object Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET_NAME=olympido-production-assets
S3_ACCESS_KEY=your_production_s3_access_key
S3_SECRET_KEY=your_production_s3_secret_key

# OAuth Providers (Google & GitHub)
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_CALLBACK_URL=https://api.olympido.com/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
GITHUB_CALLBACK_URL=https://api.olympido.com/api/v1/auth/oauth/github/callback

# SMTP / Email Service (Transactional Notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_ses_api_key
EMAIL_FROM=Olympido Olympiad Platform <noreply@olympido.com>
